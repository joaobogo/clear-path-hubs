          },
          "required": [
            "positionId"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_shortlist",
        "title": "List shortlisted candidates",
        "description": "List the candidates released to the client for one role, with stage and fit label. Only candidates already shared with the client are returned.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
